html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: Inter, 'Segoe UI', sans-serif;
}

:root {
  color-scheme: dark;
}

html[data-theme='dark'] {
  --bg: #0f172a;
  --bg-2: #111827;
  --panel: rgba(17, 24, 39, 0.9);
  --panel-strong: rgba(31, 41, 55, 0.95);
  --text: #e5eefb;
  --muted: #a8b3c7;
  --accent: #60a5fa;
  --accent-strong: #3b82f6;
  --success: #22c55e;
  --warning: #fbbf24;
  --danger: #ef4444;
  --shadow: rgba(15, 23, 42, 0.45);
  --outline: rgba(148, 163, 184, 0.2);
}

html[data-theme='light'] {
  --bg: #edf5ff;
  --bg-2: #dfeafc;
  --panel: rgba(255, 255, 255, 0.88);
  --panel-strong: rgba(255, 255, 255, 0.96);
  --text: #162339;
  --muted: #4e5b75;
  --accent: #2563eb;
  --accent-strong: #1d4ed8;
  --success: #16a34a;
  --warning: #d97706;
  --danger: #dc2626;
  --shadow: rgba(37, 99, 235, 0.18);
  --outline: rgba(37, 99, 235, 0.1);
}

body {
  background: linear-gradient(135deg, var(--bg), var(--bg-2));
  color: var(--text);
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

button:hover {
  transform: translateY(-1px);
}

.app-shell {
  min-height: 100%;
  display: grid;
  place-items: center;
  padding: 24px;
}

.app-card {
  width: min(100%, 560px);
  background: var(--panel);
  border: 1px solid var(--outline);
  border-radius: 28px;
  box-shadow: 0 24px 60px var(--shadow);
  padding: 24px;
  backdrop-filter: blur(14px);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 6vw, 2.6rem);
}

.theme-toggle {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--panel-strong);
  color: var(--text);
  font-size: 1.2rem;
  border: 1px solid var(--outline);
}

.clock-display {
  font-size: clamp(2.3rem, 7vw, 4rem);
  font-weight: 800;
  letter-spacing: 0.08em;
  text-align: center;
  margin: 24px 0 28px;
}

.alarm-form {
  display: grid;
  gap: 12px;
  margin-bottom: 20px;
}

.alarm-form input,
.alarm-form select {
  width: 100%;
  background: var(--panel-strong);
  color: var(--text);
  border: 1px solid var(--outline);
  border-radius: 14px;
  padding: 14px 16px;
  outline: none;
}

.primary-btn,
.secondary-btn,
.toggle-btn,
.delete-btn {
  border-radius: 12px;
  padding: 12px 14px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: white;
}

.secondary-btn {
  background: rgba(251, 191, 36, 0.18);
  color: var(--warning);
}

.alarm-list {
  display: grid;
  gap: 12px;
}

.empty-state {
  margin: 0;
  text-align: center;
  color: var(--muted);
  padding: 18px 10px;
}

.alarm-item {
  background: var(--panel-strong);
  border: 1px solid var(--outline);
  border-radius: 18px;
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.alarm-item.ringing {
  border-color: rgba(239, 68, 68, 0.8);
  box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.42);
  animation: pulse 0.8s infinite alternate;
}

@keyframes pulse {
  from { background: rgba(239, 68, 68, 0.08); }
  to { background: rgba(251, 191, 36, 0.12); }
}

.alarm-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.alarm-meta strong {
  font-size: 1.3rem;
}

.alarm-meta span {
  color: var(--muted);
  font-size: 0.82rem;
}

.alarm-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.toggle-btn {
  min-width: 70px;
}

.toggle-btn.enabled {
  background: rgba(34, 197, 94, 0.15);
  color: var(--success);
}

.toggle-btn.disabled {
  background: rgba(148, 163, 184, 0.15);
  color: var(--muted);
}

.delete-btn {
  background: rgba(239, 68, 68, 0.12);
  color: var(--danger);
}

.ringing-modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.64);
  display: grid;
  place-items: center;
  padding: 20px;
}

.ringing-panel {
  width: min(100%, 420px);
  background: var(--panel);
  border: 1px solid var(--outline);
  border-radius: 24px;
  padding: 28px 24px;
  text-align: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
}

.ringing-label {
  margin: 0 0 8px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
}

.ringing-panel h2 {
  margin: 0;
  font-size: clamp(2.1rem, 7vw, 3.4rem);
}

.ringing-panel p {
  margin: 10px 0 0;
  color: var(--muted);
}

.ringing-actions {
  margin-top: 22px;
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

@media (max-width: 480px) {
  .app-card {
    padding: 18px;
    border-radius: 22px;
  }

  .topbar {
    align-items: flex-start;
  }

  .alarm-item {
    align-items: flex-start;
    flex-direction: column;
  }

  .alarm-actions {
    width: 100%;
    justify-content: flex-start;
  }
}
